# Скопируйте в .env и при необходимости поменяйте значения. Файл .env не коммитится.

# PostgreSQL
DB_NAME=vrazumi
DB_USER=vrazumi
DB_PASSWORD=change-me
DB_PORT=5432

# Порт ядра на хосте
CORE_PORT=8080

# Контексты Liquibase: default — только схема, demo — схема и демо-данные
LIQUIBASE_CONTEXTS=default

# Ключ подписи JWT, не короче 32 символов. Для своего окружения сгенерируйте новый:
#   openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

# Разрешённые origin фронтенда (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
