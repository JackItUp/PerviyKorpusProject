<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Карточка «варианты»: ответ задаётся вариантами, поле answer у неё пустое -->
    <changeSet id="009-card-options" author="vrazumi">
        <dropNotNullConstraint tableName="card" columnName="answer" columnDataType="varchar(2000)"/>

        <createTable tableName="card_option">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_card_option"/>
            </column>
            <column name="card_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_card_option_card"
                             referencedTableName="card"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <!-- Порядок вариантов, как их задал автор -->
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="correct" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="card_option" columnNames="card_id, position"
                             constraintName="uq_card_option_card_position"/>
    </changeSet>

</databaseChangeLog>
